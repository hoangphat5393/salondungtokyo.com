# Laravel & PHP dependencies
/vendor/
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Node & Vite build artifacts
/node_modules/
/public/build/
/public/hot
/public/storage
.vite/
.cache/

# Environment files (NEVER commit secrets)
.env
.env.backup
.env.production
.env.local
.env.*.local

# Storage runtime files
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/debugbar/*

# Testing & IDE helpers
/.phpunit.cache
.phpunit.result.cache
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
Homestead.json
Homestead.yaml
auth.json

# Code graph & generated caches
/graphify-out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor, IDE & OS files
/.fleet
/.idea
/.nova
/.vscode/*
!/.vscode/extensions.json
/.zed
*.sw?
.DS_Store
Thumbs.db
desktop.ini
Desktop.ini
.ftpquota
